[Unit]
Description=LinuxCare privileged maintenance helper
Documentation=https://github.com/MilMit/LinuxCare/blob/main/SECURITY.md

[Service]
Type=dbus
BusName=net.milmit.LinuxCare.Helper
ExecStart=/usr/libexec/linuxcare-helper
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RuntimeMaxSec=15min

[Install]
WantedBy=multi-user.target
